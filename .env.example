# TapeCloud Auth Core - Environment Configuration
# Copia este archivo a .env y completa tus valores.
# Los nombres deben coincidir con los que lee application.properties y docker-compose.yml.

# Server Configuration
# PORT lo inyecta Railway automáticamente; en local vale 8080.
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# CORS de producción: URLs públicas de tus frontends separadas por comas
# (solo necesario al desplegar; en local se deja vacío).
# Ej: CORS_ALLOWED_ORIGINS=https://portal.up.railway.app,https://tapeflix.vercel.app
CORS_ALLOWED_ORIGINS=

# Database Configuration (H2 por defecto en local)
# En producción (Aiven): convertí el "Service URI" de Aiven
# (postgres://user:pass@host:port/dbname?sslmode=require) a formato JDBC:
# DB_URL=jdbc:postgresql://host:port/dbname?sslmode=require
# DB_USERNAME=<user de Aiven>
# DB_PASSWORD=<password de Aiven>
# DB_DRIVER_CLASS_NAME=org.postgresql.Driver
# HIBERNATE_DIALECT=org.hibernate.dialect.PostgreSQLDialect
DB_URL=jdbc:h2:file:./data/tapecloud;MODE=PostgreSQL
DB_USERNAME=sa
DB_PASSWORD=
DB_DRIVER_CLASS_NAME=org.h2.Driver
HIBERNATE_DIALECT=org.hibernate.dialect.H2Dialect

# JWT Configuration
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRATION_MS=28800000

# 2FA/TOTP Configuration (nombre que se muestra en apps como Google Authenticator)
TOTP_ISSUER=TapeCloud

# Cuentas que reciben ROLE_ADMIN automáticamente al registrarse (separadas por coma).
# Vacío por defecto: no hay admin hasta crear el primero con ADMIN_BOOTSTRAP_*.
ADMIN_EMAILS=

# Alta del primer admin: solo se usa una vez, mientras no exista NINGUNA cuenta con ROLE_ADMIN
# en la base (ver DataInitializer). No dejar esto seteado en producción de forma permanente:
# una vez creado el primer admin, sacá estas dos variables del entorno.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# SMTP para envío de códigos de verificación (Gmail)
# MAIL_PASSWORD es una App Password de Google (requiere 2FA activado en la cuenta),
# no la contraseña normal de Gmail: https://myaccount.google.com/apppasswords
# NOTA Railway: la salida SMTP a Gmail se cuelga (timeout puerto 587).
# Recomendado en prod: usar Brevo por API HTTPS (ver abajo) y dejar el SMTP solo local.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=tu-cuenta@gmail.com
MAIL_PASSWORD=your-gmail-app-password
MAIL_FROM=tu-cuenta@gmail.com

# Brevo por API HTTPS (https://www.brevo.com, plan gratis 300 mails/día).
# 1. Creá cuenta, verificá tu email como remitente (Settings > Senders).
# 2. Generá API key (Settings > SMTP & API > API Keys).
# 3. Seteá estas 2 variables en Railway y redeploy.
BREVO_API_KEY=
BREVO_SENDER_NAME=TapeCloud

# TMDb API Configuration (TapeFlix)
# Conseguí la key en https://www.themoviedb.org/settings/api
TMDB_API_KEY=your-tmdb-api-key-here
TMDB_API_READ_ACCESS_TOKEN=
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p/w500
TMDB_LANGUAGE=es-ES

# Last.fm API Configuration (TapeBeat)
# Conseguí la key en https://www.last.fm/api/account/create
LASTFM_API_KEY=your-lastfm-api-key-here
LASTFM_BASE_URL=https://ws.audioscrobbler.com/2.0

# MusicBrainz API Configuration
# Sin API key: solo pide un User-Agent identificable con nombre, version y contacto.
MUSICBRAINZ_API_BASE_URL=https://musicbrainz.org/ws/2
MUSICBRAINZ_APP_NAME=TapeCloud
MUSICBRAINZ_APP_VERSION=1.0
MUSICBRAINZ_CONTACT_EMAIL=tu-email@ejemplo.com

# Frontend Configuration
VITE_API_URL=http://localhost:8080

# Moderaci├│n: filtro de lenguaje no hardcodeado (listas en src/main/resources/profanity/*.txt)
# Vac├¡o = activado con las listas de recursos. Palabras extra separadas por coma.
PROFANITY_ENABLED=true
PROFANITY_EXTRA_WORDS=

# Rese├▒as: cooldown entre ediciones (segundos) y l├¡mites de caracteres
REVIEW_EDIT_COOLDOWN_SECONDS=30
REVIEW_TITLE_MAX=150
REVIEW_BODY_MAX=750

# Avatar: peso m├íximo en bytes y tipos permitidos
AVATAR_MAX_BYTES=524288
AVATAR_ALLOWED_TYPES=image/png,image/jpeg,image/webp,image/gif
AVATAR_MAX_DIMENSION=2048
AVATAR_MIN_DIMENSION=32

# Moderaci├│n de im├ígenes externa (opcional, ej. sightengine). Vac├¡o = solo controles locales.
MODERATION_IMAGE_PROVIDER=none
MODERATION_IMAGE_API_KEY=
